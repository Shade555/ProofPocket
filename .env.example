# ProofPocket Environment Configuration
# Copy this file to .env.local for local development

# Application Server Port & Environment
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Google Gemma Model Provider Configuration
# -----------------------------------------------------------------------------
# ProofPocket supports any OpenAI-compatible inference endpoint hosting Gemma 2
# (e.g. vLLM, HuggingFace TGI, OpenRouter, Groq, Google Cloud Vertex AI endpoint).
# For local inference via Ollama, use: http://localhost:11434/v1
#
# NOTE: If GEMMA_API_BASE_URL and GEMMA_API_KEY are omitted, ProofPocket runs in
# explicitly labelled DEMO MODE using deterministic synthetic fixtures.
GEMMA_API_BASE_URL=http://localhost:11434/v1
GEMMA_API_KEY=
GEMMA_MODEL_NAME=google/gemma-2-9b-it

# -----------------------------------------------------------------------------
# MongoDB Atlas Database Configuration
# -----------------------------------------------------------------------------
# If MONGODB_URI is omitted, ProofPocket runs using its in-memory storage fallback,
# pre-seeded with the synthetic scholarship fellowship demo.
MONGODB_URI=
MONGODB_DB_NAME=proofpocket

# Optional: MongoDB Atlas Vector Search index name (requires Atlas Vector Search index)
ATLAS_VECTOR_INDEX_NAME=proofpocket_vector_index
EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# Sentry Error Monitoring & Telemetry
# -----------------------------------------------------------------------------
# Set NEXT_PUBLIC_SENTRY_ENABLED=false to disable all telemetry.
# All document text, personal data, and credentials are strictly redacted before sending.
NEXT_PUBLIC_SENTRY_ENABLED=true
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Upload Security Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_FILE_SIZE_MB=15
MAX_UPLOAD_FILES_COUNT=10
